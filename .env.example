# Copy this file to .env on the deployment machine and replace every value.
# Never commit the real .env file or bake these values into the image.

POSTGRES_USER=novazheh
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=novazheh
# Set this to the exact existing Docker volume name on the server before deployment.
POSTGRES_VOLUME_NAME=novazheh-postgres-data

# Production database mode. Compose passes this to the backend and forces PostgreSQL.
USE_POSTGRES=true
# The Ktor server listens on this port and binds to 0.0.0.0. Defaults to 8080.
SERVER_PORT=8080

# Compose intentionally derives these backend variables from POSTGRES_* above:
# DATABASE_URL=jdbc:postgresql://postgres:5432/${POSTGRES_DB}
# DATABASE_USER=${POSTGRES_USER}
# DATABASE_PASSWORD=${POSTGRES_PASSWORD}

JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=novazheh-server
JWT_AUDIENCE=novazheh-users

# Use the hostname/IP clients will use to reach the backend.
CONTENT_BASE_URL=http://SERVER_HOST_OR_IP:8080
